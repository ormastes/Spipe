plugin:
  name: spipe
  version: 0.2.0
  description: Reusable SPipe development, release, and scoped self-review admission module
  cli: cli/spipe.js
  mcp: mcp/server.js
  setup:
    unix: scripts/setup-spipe-links.sh
    windows: scripts/setup-spipe-links.ps1
  schemas:
    vcs_policy: spipe-vcs/3
    session: spipe-session/1
    release: spipe-release/1
    candidate: spipe-candidate/1
    review_request: spipe-review-request/1
    review_admission: spipe-review-admission/1
    self_review_request: spipe-self-review-request/1
    self_review_decision: spipe-self-review-decision/1
    self_review_admission: spipe-self-review-admission/1
  capabilities:
    isolated_sessions: true
    reviewed_beta_backports: true
    immutable_release_candidates: true
    promote_without_rebuild: true
    non_destructive_withdrawal_planning: true
    operational_release_planning: true
    main_fix_discovery_planning: true
    release_first_forward_port_validation: true
    external_release_mutation: false
    non_mutating_review_requests: true
    server_resolved_review_heads: true
    broker_verified_review_admission: true
    external_review_mutation: false
    default_allow_scoped_self_review: true
    broker_only_self_review_admission_check: true
    operator_owned_text_policy_db: true
    self_review_ruleset_requires_exact_check: true
    provider_author_approval: false
    user_authorized_self_review_only: true
    structured_self_review_rejection_guidance: true
