"""Test-only authority and explicit bindings; never used by production adapters."""

use lifecycle.contracts.{LifecycleRunV1, GateRequirementV1, GateEvidenceV1,
    GateWaiverV1, LifecycleAuthorityV1}

val FIXTURE_SOURCE = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val FIXTURE_DIGEST = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
val FIXTURE_EXECUTABLE = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
val FIXTURE_INPUTS = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
val FIXTURE_EVIDENCE = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"

class FixtureLifecycleAuthorityV1 with LifecycleAuthorityV1:
    policy_allowed: bool = true
    evidence_verified: bool = true
    waiver_verified: bool = true
    expected_outcome: text = "red"
    require_negative: bool = true
    allow_not_applicable: bool = false
    minimum_cases: i64 = 2

    fn authorize_gate(run: LifecycleRunV1, requirement: GateRequirementV1) -> bool:
        self.policy_allowed and run.policy_sha256 == FIXTURE_DIGEST and requirement.gate_id == "acceptance.red" and
            requirement.target_state == "test_ready" and requirement.executable_sha256 == FIXTURE_EXECUTABLE and
            requirement.selector == "lifecycle.acceptance" and requirement.inputs_sha256 == FIXTURE_INPUTS and
            requirement.expected_outcome == self.expected_outcome and requirement.minimum_cases == self.minimum_cases and
            requirement.require_negative == self.require_negative and requirement.allow_not_applicable == self.allow_not_applicable

    fn verify_evidence(evidence: GateEvidenceV1) -> bool:
        self.evidence_verified and evidence.evidence_sha256 == FIXTURE_EVIDENCE

    fn verify_waiver(waiver: GateWaiverV1) -> bool:
        self.waiver_verified and waiver.authority_id == "fixture-owner" and waiver.evidence_sha256 == FIXTURE_EVIDENCE

    fn authorize_transition(run: LifecycleRunV1, target: text, requirements: [GateRequirementV1]) -> bool:
        self.policy_allowed and run.policy_sha256 == FIXTURE_DIGEST and target == "test_ready" and
            requirements.len() == 1 and self.authorize_gate(run, requirements[0])

fn fixture_run() -> LifecycleRunV1:
    LifecycleRunV1(schema: "spipe-lifecycle-run/1", run_id: "run-fixture",
        source_revision: FIXTURE_SOURCE, policy_sha256: FIXTURE_DIGEST,
        state: "designed", generation: 4)

fn fixture_requirement() -> GateRequirementV1:
    GateRequirementV1(gate_id: "acceptance.red", target_state: "test_ready",
        executable_sha256: FIXTURE_EXECUTABLE, selector: "lifecycle.acceptance",
        inputs_sha256: FIXTURE_INPUTS, expected_outcome: "red", minimum_cases: 2,
        require_negative: true, allow_not_applicable: false)

fn fixture_evidence() -> GateEvidenceV1:
    GateEvidenceV1(schema: "spipe-lifecycle-evidence/1", run_id: "run-fixture", run_generation: 4,
        gate_id: "acceptance.red", source_revision: FIXTURE_SOURCE, policy_sha256: FIXTURE_DIGEST,
        executable_sha256: FIXTURE_EXECUTABLE, selector: "lifecycle.acceptance",
        inputs_sha256: FIXTURE_INPUTS, evidence_sha256: FIXTURE_EVIDENCE,
        outcome: "red", executed_cases: 2, failed_cases: 2, negative_cases: 1,
        negative_failed_cases: 1, rationale: "positive and negative scenarios failed before implementation",
        issued_at_ms: 100, expires_at_ms: 200)

fn fixture_waiver() -> GateWaiverV1:
    GateWaiverV1(schema: "spipe-lifecycle-waiver/1", run_id: "run-fixture", run_generation: 4, gate_id: "acceptance.red",
        source_revision: FIXTURE_SOURCE, policy_sha256: FIXTURE_DIGEST,
        authority_id: "fixture-owner", reviewer_id: "fixture-reviewer",
        executable_sha256: FIXTURE_EXECUTABLE, selector: "lifecycle.acceptance", inputs_sha256: FIXTURE_INPUTS,
        reason: "isolated migration fixture", compensating_control: "hold production promotion",
        evidence_sha256: FIXTURE_EVIDENCE, issued_at_ms: 100, expires_at_ms: 200)
